# Copy this file to .env and change all production secrets.
APP_NAME=Smart AI Glasses Web
SECRET_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=8000
ORIGIN=http://localhost:8000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Smart AI Glasses Web
SECURE_COOKIES=false
SESSION_MAX_AGE=28800

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@12345
ADMIN_DISPLAY_NAME=System Administrator

# Optional: enables advanced AI chat, vision, transcription and natural voice.
OPENAI_API_KEY=
AI_TEXT_MODEL=gpt-5-mini
AI_VISION_MODEL=gpt-5-mini
AI_VOICE_MODEL=gpt-4o-mini-tts
AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
